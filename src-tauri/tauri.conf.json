{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Drop Involve",
  "version": "0.1.22",
  "identifier": "no.involve.drop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drop Involve",
        "width": 850,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/medi2015/drop-involve-frontend/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNTc0OEFCNDg2MzA2MDcKUldRSEJtTklxMGhYc3BBNTFScTkzRmZSWmQ2T2wvZEhOVWtXQUdNd3BXSERQZDg5eGRmYjhPWGUK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
