{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Drop Involve",
  "version": "0.1.0",
  "identifier": "no.involve.drop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drop Involve",
        "width": 850,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "tray",
        "title": "Historikk",
        "width": 350,
        "height": 450,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}